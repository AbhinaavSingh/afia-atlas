# Public browser values from Supabase > Project Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Public site key from Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# Edge Function secrets (set with `supabase secrets set`, never in .env)
# TURNSTILE_SECRET_KEY=
# ALLOWED_ORIGINS=https://your-domain.com,https://your-project.pages.dev
# RATE_LIMIT_SALT=generate-a-long-random-value
